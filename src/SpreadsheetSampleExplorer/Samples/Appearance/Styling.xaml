<UserControl x:Class="SpreadsheetSampleExplorer.Samples.Styling"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpreadsheetSampleExplorer.Samples" 
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Interactive Styling Toolbar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1"  Padding="10,6" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Palette:" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#3F3F46" Margin="0,0,6,0"/>
                    <ComboBox x:Name="_cmbTheme" Style="{StaticResource ModernComboBox}" Width="150"
                              SelectionChanged="OnThemeChanged" SelectedIndex="0">
                        <ComboBoxItem Tag="Slate">Slate Minimalist</ComboBoxItem>
                        <ComboBoxItem Tag="Excel">Excel Classic Green</ComboBoxItem>
                        <ComboBoxItem Tag="Emerald">Emerald Sage</ComboBoxItem>
                        <ComboBoxItem Tag="Indigo">Indigo Studio</ComboBoxItem>
                        <ComboBoxItem Tag="Corporate">Corporate Navy</ComboBoxItem>
                    </ComboBox>

                    <CheckBox x:Name="_chkAltRows" Content="Alternating Rows" IsChecked="True" 
                              VerticalAlignment="Center" Margin="14,0,14,0" Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

                    <TextBlock Text="Align:" VerticalAlignment="Center" FontSize="11.5" Foreground="#52525B" Margin="0,0,6,0"/>
                    <ComboBox x:Name="_cmbAlign" Style="{StaticResource ModernComboBox}" Width="90" SelectedIndex="1" SelectionChanged="OnOptionChanged">
                        <ComboBoxItem Tag="Left">Left</ComboBoxItem>
                        <ComboBoxItem Tag="Center">Center</ComboBoxItem>
                        <ComboBoxItem Tag="Right">Right</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- View Mode Switch -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="_radioSingleView" Content="Single View" GroupName="ViewMode" IsChecked="True" 
                                 Margin="0,0,10,0" Checked="OnViewModeChanged"/>
                    <RadioButton x:Name="_radioQuadView" Content="Grid Showcase" GroupName="ViewMode" 
                                 Checked="OnViewModeChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace Area -->
        <Grid Grid.Row="1">
            <!-- Single Full Sheet View -->
            <Border x:Name="_bdrSingleView" BorderThickness="1" BorderBrush="#E4E4E7"  Background="White" Visibility="Visible">
                <sheets:Spread x:Name="spreadMain"/>
            </Border>

            <!-- 4-Quadrant Theme Showcase Grid View -->
            <Grid x:Name="_gridQuadView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Quadrant 1 -->
                <Border Grid.Row="0" Grid.Column="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1"  Padding="6" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Slate Minimalist" FontSize="11" FontWeight="SemiBold" Foreground="#18181B" Margin="0,0,0,4"/>
                        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" CornerRadius="4" Background="White">
                            <sheets:Spread x:Name="spread1"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Quadrant 2 -->
                <Border Grid.Row="0" Grid.Column="1" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1"  Padding="6" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Excel Classic Green" FontSize="11" FontWeight="SemiBold" Foreground="#107C41" Margin="0,0,0,4"/>
                        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" CornerRadius="4" Background="White">
                            <sheets:Spread x:Name="spread2"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Quadrant 3 -->
                <Border Grid.Row="1" Grid.Column="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1"  Padding="6" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Indigo Studio" FontSize="11" FontWeight="SemiBold" Foreground="#18181B" Margin="0,0,0,4"/>
                        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" CornerRadius="4" Background="White">
                            <sheets:Spread x:Name="spread3"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Quadrant 4 -->
                <Border Grid.Row="1" Grid.Column="1" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1"  Padding="6" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Corporate Navy" FontSize="11" FontWeight="SemiBold" Foreground="#18181B" Margin="0,0,0,4"/>
                        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" CornerRadius="4" Background="White">
                            <sheets:Spread x:Name="spread4"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
