<UserControl x:Class="SpreadsheetSampleExplorer.Samples.Performance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpreadsheetSampleExplorer.Samples"
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Control & Configuration Bar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                    <TextBlock Text="Scroll Mode:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#3F3F46" Margin="0,0,8,0"/>
                    <ComboBox x:Name="_cmbScrollMode" Style="{StaticResource ModernComboBox}"
                              Width="140" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Tag="Item">Item Scrolling</ComboBoxItem>
                        <ComboBoxItem Tag="Pixel">Pixel Scrolling</ComboBoxItem>
                        <ComboBoxItem Tag="Deferred">Deferred Scrolling</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                    <TextBlock Text="Dataset Size:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#3F3F46" Margin="0,0,8,0"/>
                    <ComboBox x:Name="_cmbRowCount" Style="{StaticResource ModernComboBox}"
                              Width="140" SelectedIndex="2" VerticalAlignment="Center">
                        <ComboBoxItem Tag="100000">100,000 Rows</ComboBoxItem>
                        <ComboBoxItem Tag="500000">500,000 Rows</ComboBoxItem>
                        <ComboBoxItem Tag="1000000">1,000,000 Rows</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <Button Content="⚡ Run Benchmark" Style="{StaticResource ModernButton}" 
                        Click="OnRunBenchmarkClick" Margin="0,4,0,4" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- Benchmark Statistics Dashboard Card -->
        <Border Grid.Row="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Load Time Main Highlight Badge -->
                <Border Grid.Column="0" Background="#107C41" CornerRadius="6" Padding="14,8" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL LOAD TIME" FontSize="9.5" FontWeight="Bold" Foreground="#DCFCE7" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="_txtTotalTime" Text="-- ms" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Detailed Metrics Grid -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- Data Prep Time -->
                    <Border Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,3,10,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Data Prep: " FontSize="11" Foreground="#71717A" FontWeight="Medium"/>
                            <TextBlock x:Name="_txtPrepTime" Text="-- ms" FontSize="11" Foreground="#18181B" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Engine Load Time -->
                    <Border Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,3,10,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Engine Load: " FontSize="11" Foreground="#71717A" FontWeight="Medium"/>
                            <TextBlock x:Name="_txtLoadTime" Text="-- ms" FontSize="11" Foreground="#18181B" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- UI Render Time -->
                    <Border Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,3,10,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="First Render: " FontSize="11" Foreground="#71717A" FontWeight="Medium"/>
                            <TextBlock x:Name="_txtRenderTime" Text="-- ms" FontSize="11" Foreground="#18181B" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Dataset Stats -->
                    <Border Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,3,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Volume: " FontSize="11" Foreground="#71717A" FontWeight="Medium"/>
                            <TextBlock x:Name="_txtCellCount" Text="1,000,000 rows × 10 cols" FontSize="11" Foreground="#107C41" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main Spreadsheet View -->
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="#E4E4E7" CornerRadius="6">
            <sheets:Spread x:Name="spread" ScrollMode="{Binding ElementName=_cmbScrollMode, Path=SelectedItem.Tag, Mode=TwoWay}"/>
        </Border>
    </Grid>
</UserControl>
