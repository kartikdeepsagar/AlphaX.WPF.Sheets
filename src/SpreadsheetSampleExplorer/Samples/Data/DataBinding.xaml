<UserControl x:Class="SpreadsheetSampleExplorer.Samples.DataBinding"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpreadsheetSampleExplorer.Samples" 
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Column 1: POCO List Binding -->
        <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,3,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="C# POCO List Binding" FontSize="12.5" FontWeight="SemiBold" Foreground="#18181B" VerticalAlignment="Center"/>
                    <Border Background="#F4F4F5" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="List&lt;Customer&gt;" FontSize="10" FontWeight="Medium" Foreground="#52525B"/>
                    </Border>
                </DockPanel>

                <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" CornerRadius="4" Background="White">
                    <sheets:Spread x:Name="spread"/>
                </Border>
            </Grid>
        </Border>

        <!-- Column 2: DataTable Binding -->
        <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="6" Margin="3,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="ADO.NET DataTable Binding" FontSize="12.5" FontWeight="SemiBold" Foreground="#18181B" VerticalAlignment="Center"/>
                    <Border Background="#F4F4F5" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DataTable" FontSize="10" FontWeight="Medium" Foreground="#52525B"/>
                    </Border>
                </DockPanel>

                <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" CornerRadius="4" Background="White">
                    <sheets:Spread x:Name="spread2"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
