<UserControl x:Class="SpreadsheetSampleExplorer.Samples.RealTimeFeed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact Real-time Control Toolbar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="⚡ Live Price Stream" Foreground="#0F766E" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="🔄 Real-Time Formulas" Foreground="#0F766E" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <TextBlock x:Name="txtStatus" Text="Status: Live Streaming (Ticks: 0)" 
                               Foreground="#71717A" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Interactive Live Controls (Right Aligned) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnToggleFeed" Content="⏸️ Pause Feed" Click="OnToggleFeedClicked" 
                            Style="{StaticResource ModernOutlineButton}" Padding="10,4" Margin="0,0,6,0" FontSize="11"/>
                    <Button x:Name="btnSimulateMarket" Content="🎲 Market Shift" Click="OnSimulateMarketClicked" 
                            Style="{StaticResource ModernButton}" Padding="10,4" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Spread Control -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" CornerRadius="6">
            <sheets:Spread x:Name="spread"/>
        </Border>
    </Grid>
</UserControl>
