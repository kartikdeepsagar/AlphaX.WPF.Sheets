<UserControl x:Class="SpreadsheetSampleExplorer.Samples.Formulas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpreadsheetSampleExplorer.Samples"
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact Formula Engine Bar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1"  Padding="10,6" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="🔗 Cross-Sheet Interlinked Formulas" Foreground="#107C41" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="📊 SUM, AVERAGE, MIN, MAX" Foreground="#107C41" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <TextBlock Text="💡 Tip: Edit any cell in 'Regional Sales' to see 'Summary Dashboard' update!" 
                               Foreground="#71717A" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Main Spread Control -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" >
            <sheets:Spread x:Name="spread"/>
        </Border>
    </Grid>
</UserControl>
