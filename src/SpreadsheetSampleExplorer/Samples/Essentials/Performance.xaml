<UserControl x:Class="SpreadsheetSampleExplorer.Samples.Performance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpreadsheetSampleExplorer.Samples"
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact Control & Benchmark Toolbar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1"  Padding="10,6" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Scroll Mode:" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#3F3F46" Margin="0,0,6,0"/>
                    <ComboBox x:Name="_cmbScrollMode" Style="{StaticResource ModernComboBox}" Width="130" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Tag="Item">Item Scrolling</ComboBoxItem>
                        <ComboBoxItem Tag="Pixel">Pixel Scrolling</ComboBoxItem>
                        <ComboBoxItem Tag="Deferred">Deferred Scrolling</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="Dataset:" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#3F3F46" Margin="14,0,6,0"/>
                    <ComboBox x:Name="_cmbRowCount" Style="{StaticResource ModernComboBox}" Width="130" SelectedIndex="2" VerticalAlignment="Center">
                        <ComboBoxItem Tag="100000">100,000 Rows</ComboBoxItem>
                        <ComboBoxItem Tag="500000">500,000 Rows</ComboBoxItem>
                        <ComboBoxItem Tag="1000000">1,000,000 Rows</ComboBoxItem>
                    </ComboBox>

                    <Button Content="⚡ Load Data" Style="{StaticResource ModernButton}" Click="OnRunBenchmarkClick" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Compact Benchmark Stats Badges -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#107C41" CornerRadius="4" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LOAD TIME: " FontSize="10" FontWeight="Bold" Foreground="#DCFCE7"/>
                            <TextBlock x:Name="_txtTotalTime" Text="-- ms" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F4F4F5" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock x:Name="_txtCellCount" Text="1,000,000 rows × 10 cols" FontSize="10.5" Foreground="#52525B" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Spreadsheet View -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" >
            <sheets:Spread x:Name="spread" ScrollMode="{Binding ElementName=_cmbScrollMode, Path=SelectedItem.Tag, Mode=TwoWay}"/>
        </Border>
    </Grid>
</UserControl>
